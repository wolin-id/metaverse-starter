{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld"
  ],
  "client_id": "https://world.example.com/client-id.jsonld",
  "client_name": "Wolin Metaverse Starter Plaza",
  "client_uri": "https://world.example.com/",
  "logo_uri": "https://world.example.com/logo.svg",
  "redirect_uris": [
    "https://world.example.com/",
    "https://world.example.com/auth/callback"
  ],
  "post_logout_redirect_uris": [
    "https://world.example.com/"
  ],
  "scope": "openid webid offline_access",
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "token_endpoint_auth_method": "none",
  "application_type": "web",
  "dpop_bound_access_tokens": true,
  "contacts": [
    "ops@world.example.com"
  ]
}
